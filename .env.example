# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# The .env file is git-ignored and NEVER committed.
# The .env.example file IS committed — it is the template for the team.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini Advisor ────────────────────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/apikey
# Required only to exercise the live LLM path.
# Without it, the advisor silently falls back to the default pass order
# and all tests still pass.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model (default: gemini-1.5-flash, free tier)
# ADVISOR_MODEL=gemini-1.5-pro
